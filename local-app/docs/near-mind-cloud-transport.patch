diff --git a/tests_bridge/test_cloud_transport.py b/tests_bridge/test_cloud_transport.py
new file mode 100644
index 0000000..c6951e9
--- /dev/null
+++ b/tests_bridge/test_cloud_transport.py
@@ -0,0 +1,72 @@
+"""McpCloudTransport against the stub MCP server: no real WhatsApp / Meta traffic."""
+import hashlib
+import hmac
+import json
+import sys
+from pathlib import Path
+
+import pytest
+
+from bridge.transport import McpCloudTransport, TransportError, verify_meta_signature
+
+STUB = Path(__file__).parent / "fake_mcp_server.py"
+
+
+@pytest.fixture()
+def log_path(tmp_path):
+    return tmp_path / "calls.ndjson"
+
+
+@pytest.fixture()
+def t(log_path):
+    tr = McpCloudTransport(stdio_command=[sys.executable, str(STUB), str(log_path)],
+                           contacts={"karim": "+966 55 123 4567"}, timeout_seconds=10)
+    yield tr
+    tr.close()
+
+
+def calls(p):
+    return [json.loads(line) for line in p.read_text().splitlines()] if p.exists() else []
+
+
+def hook(*msgs):
+    return {"entry": [{"changes": [{"value": {"messages": list(msgs)}}]}]}
+
+
+def test_contacts_are_normalised_to_digits(t):
+    assert t.resolve_key("karim") == "966551234567"
+
+
+def test_send_calls_cloud_tool_and_returns_wamid(t, log_path):
+    assert t.send_text("966551234567@s.whatsapp.net", "hello") == "wamid.TEST1"
+    assert calls(log_path)[-1] == {"tool": "send_whatsapp_message",
+                                   "args": {"phone_number": "966551234567", "message": "hello"}}
+
+
+def test_api_error_becomes_transport_error(t):
+    with pytest.raises(TransportError, match="not in allowed list"):
+        t.send_text("0", "hi")
+
+
+def test_webhook_text_is_delivered_once(t):
+    m = {"id": "wamid.A", "from": "966551234567", "type": "text", "timestamp": "1790000000", "text": {"body": "got a ladder"}}
+    assert t.ingest_webhook(hook(m)) == 1
+    assert t.ingest_webhook(hook(m)) == 0                      # Meta retries: dedupe
+    got = t.fetch_inbound(since=None)
+    assert [(g.message_id, g.sender_key, g.content) for g in got] == [("wamid.A", "966551234567", "got a ladder")]
+    assert t.fetch_inbound(since=None) == []
+
+
+def test_non_text_and_status_payloads_are_ignored(t):
+    img = {"id": "wamid.B", "from": "966551234567", "type": "image", "timestamp": "1790000000"}
+    assert t.ingest_webhook(hook(img)) == 0
+    assert t.ingest_webhook({"entry": [{"changes": [{"value": {"statuses": [{"id": "x"}]}}]}]}) == 0
+
+
+def test_signature_verification_fails_closed():
+    raw = b'{"a":1}'
+    good = "sha256=" + hmac.new(b"s3cret", raw, hashlib.sha256).hexdigest()
+    assert verify_meta_signature(raw, good, "s3cret")
+    assert not verify_meta_signature(raw, good, "other")
+    assert not verify_meta_signature(raw, "", "s3cret")
+    assert not verify_meta_signature(raw, good, "")             # no secret configured => reject
