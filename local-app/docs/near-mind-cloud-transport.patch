+
+# ---------------------------------------------------------------------------
+# Meta Cloud API (test number) via tkhattar14/whatsapp-business-mcp
+# ---------------------------------------------------------------------------
+
+
+def verify_meta_signature(raw_body: bytes, signature_header: str, app_secret: str) -> bool:
+    """Check Meta's ``X-Hub-Signature-256`` (HMAC-SHA256 of the raw body). Fails closed."""
+    if not app_secret or not signature_header:
+        return False
+    want = "sha256=" + hmac.new(app_secret.encode(), raw_body, hashlib.sha256).hexdigest()
+    return hmac.compare_digest(signature_header, want)
+
+
+class McpCloudTransport(McpStdioTransport):
+    """Send through ``whatsapp-business-mcp`` (official Cloud API); receive by webhook.
+
+    The Cloud API sends from the business/test number itself, so there is no linked
+    phone and no polling: that MCP server has no ``list_messages``. Inbound messages
+    arrive as Meta webhooks; the web layer verifies the signature
+    (:func:`verify_meta_signature`) and hands the JSON to :meth:`ingest_webhook`, and
+    :meth:`fetch_inbound` drains what has arrived.
+
+    Wire keys are plain phone digits (country code, no ``+``). A test number can only
+    message recipients added in the Meta dashboard, and free text only inside the
+    24h window after the person last wrote; anything else comes back as an API
+    error and surfaces as :class:`TransportError` (the bridge records it as FAILED).
+    """
+
+    def __init__(self, *, stdio_command, env=None, contacts=None, timeout_seconds: float = 20.0) -> None:
+        digits = {cid: "".join(c for c in str(k) if c.isdigit()) for cid, k in (contacts or {}).items()}
+        super().__init__(stdio_command=stdio_command, env=env, contacts=digits, timeout_seconds=timeout_seconds)
+        self._inbox: deque = deque()
+        self._inbox_lock = threading.Lock()
+
+    def send_text(self, recipient_key: str, body: str) -> str:
+        phone = "".join(c for c in recipient_key.split("@")[0] if c.isdigit())
+        result = self._request(
+            "tools/call",
+            {"name": "send_whatsapp_message", "arguments": {"phone_number": phone, "message": body}},
+        )
+        payload = _unwrap_tool_result(result)
+        msgs = payload.get("messages") if isinstance(payload, dict) else None
+        if isinstance(msgs, list) and msgs and isinstance(msgs[0], dict) and msgs[0].get("id"):
+            return str(msgs[0]["id"])
+        detail = (payload.get("message") or payload.get("error")) if isinstance(payload, dict) else str(payload)
+        raise TransportError(f"send_whatsapp_message failed: {detail}")
+
+    def ingest_webhook(self, payload: dict) -> int:
+        """Queue inbound text messages from an already-verified Meta webhook body."""
+        added = 0
+        for entry in payload.get("entry", []) or []:
+            for change in entry.get("changes", []) or []:
+                for m in (change.get("value") or {}).get("messages", []) or []:
+                    mid = str(m.get("id") or "")
+                    frm = "".join(c for c in str(m.get("from", "")) if c.isdigit())
+                    kind = m.get("type")
+                    if not mid or not frm or mid in self._seen_ids:
+                        continue
+                    if kind not in ("text", "reaction"):
+                        continue          # statuses / media are not part of the protocol here
+                    try:
+                        ts = datetime.fromtimestamp(int(m.get("timestamp")), tz=timezone.utc)
+                    except (TypeError, ValueError):
+                        ts = datetime.now(timezone.utc)
+                    self._seen_ids.add(mid)
+                    with self._inbox_lock:
+                        self._inbox.append(TransportMessage(
+                            message_id=mid, sender_key=frm, timestamp=ts,
+                            content=((m.get("text") or {}).get("body") or "") if kind == "text" else "",
+                            is_reaction=(kind == "reaction"),
+                        ))
+                    added += 1
+        return added
+
+    def fetch_inbound(self, *, since: Optional[datetime]) -> Sequence[TransportMessage]:
+        with self._inbox_lock:
+            out = list(self._inbox)
+            self._inbox.clear()
+        return out
