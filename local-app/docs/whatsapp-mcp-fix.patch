+class StoreNotFoundError(RuntimeError):
+    """The local message store does not exist (the Go bridge has never run, or the path is wrong)."""
+
+
+def _connect() -> sqlite3.Connection:
+    # sqlite3.connect() silently creates an empty file when the path is missing, which then
+    # fails later with an opaque "no such table". Fail early and clearly instead.
+    if not os.path.isfile(MESSAGES_DB_PATH):
+        raise StoreNotFoundError(
+            f"WhatsApp message store not found at {os.path.normpath(MESSAGES_DB_PATH)}. "
+            "Start the whatsapp-bridge and let it sync before reading messages."
+        )
+    return sqlite3.connect(MESSAGES_DB_PATH)
+
+
+# --- serialisation: the one place records become plain dicts (used by the MCP layer) ---
+
+def _iso(value: Optional[datetime]) -> Optional[str]:
+    return value.isoformat() if value is not None else None
+
+
+def message_to_dict(m: Message) -> Dict[str, Any]:
+    d = asdict(m)
+    d["timestamp"] = _iso(m.timestamp)
+    d["is_from_me"] = bool(m.is_from_me)
+    return d
+
+
+def chat_to_dict(c: Chat) -> Dict[str, Any]:
+    d = asdict(c)
+    d["last_message_time"] = _iso(c.last_message_time)
+    d["last_is_from_me"] = None if c.last_is_from_me is None else bool(c.last_is_from_me)
+    d["is_group"] = c.is_group
+    return d
+
+
+def contact_to_dict(c: Contact) -> Dict[str, Any]:
+    return asdict(c)
+
+
+def context_to_dict(ctx: MessageContext) -> Dict[str, Any]:
+    return {
+        "message": message_to_dict(ctx.message),
+        "before": [message_to_dict(m) for m in ctx.before],
+        "after": [message_to_dict(m) for m in ctx.after],
+    }
+
